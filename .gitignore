.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.code-workspace

# ── Env / secrets ────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.crt
