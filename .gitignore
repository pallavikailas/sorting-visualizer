# ── Node / npm ────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.pnp
.pnp.js

# ── Build output ──────────────────────────────────────────────────────────────
dist/

# ── Test / coverage ───────────────────────────────────────────────────────────
coverage/
*.lcov
.nyc_output/

# ── Lighthouse ────────────────────────────────────────────────────────────────
lighthouse-report.report.html
lighthouse-report.report.json

# ── Docker ────────────────────────────────────────────────────────────────────
# Keep: Dockerfile, .dockerignore, nginx.conf  (committed)
# Ignore local override compose files
docker-compose.override.yml
docker-compose.local.yml

# ── Kubernetes / Helm ─────────────────────────────────────────────────────────
# Keep: k8s/helm/, k8s/manifests/, k8s/kind-config.yaml  (all committed)
# Ignore local kubeconfig overrides and rendered output
kubeconfig
kubeconfig.yaml
*.kubeconfig
helm-rendered*.yaml
/tmp-k8s/

# ── kind cluster data (generated at runtime) ──────────────────────────────────
# kind stores state in Docker; nothing written to repo at runtime

